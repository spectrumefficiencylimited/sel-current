# Build outputs, not source. These are regenerated on every workflow run and
# published to the live site; committing them added ~80 MB to git history every
# hour. Download them from:
#   https://spectrumefficiencylimited.github.io/sel-current/silver/
bronze/
silver/combined_licences.json
silver/combined_licences.csv
silver/combined_licences.duckdb
# Full client x service cross-tab: ~530 KB regenerated every run, published only.
silver/licensee_service_current.csv
# The payload analyser.html reads: ~105 KB folded out of the snapshot every run.
# Committing it would add ~900 MB of history a year to save one build step.
silver/analyser.json
# The per-assignment index the tuning panel queries: ~3.9 MB regenerated every
# run (~820 KB gzipped on the wire), fetched only when someone runs a query.
silver/analyser-index.json

# Staging directory for the GitHub Pages deployment.
_site/

# Local DuckDB write-ahead files.
*.duckdb.wal
*.tmp.*

# Python bytecode
__pycache__/
*.pyc
